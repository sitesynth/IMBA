# IMBA Platform — environment variables
# Copy to .env.prod and fill in real values

# Database
DATABASE_URL=sqlite+aiosqlite:////app/data/imba_prod.db

# Auth
JWT_SECRET=change-me-32-chars-minimum-secret

# Email (Resend)
RESEND_API_KEY=re_...

# VPN
VPN_PROVIDER=remna

# Telegram bot
BOT_TOKEN=
TELEGRAM_BOT_TOKEN=
BOT_API_SECRET=
TG_CHANNEL=@imba_live
TG_BOT_USERNAME=imba_live_bot

# Payment — CryptoBot
CRYPTOBOT_API_TOKEN=
CRYPTOBOT_ASSETS=USDT,TON,BTC,ETH

# Payment — Enot.io
ENOT_SHOP_ID=
ENOT_SECRET_KEY=

# Stripe (legacy/unused)
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
